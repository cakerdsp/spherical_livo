<launch>
  <arg name="num_cameras" default="3" />
  <arg name="config" default="$(find spherical_livo)/config/m2dgr.yaml" />
  <arg name="cameras" default="$(find spherical_livo)/config/cameras_m2dgr.yaml" />
  <arg name="output_dir" default="" />
  <arg name="use_sim_time" default="true" />
  <param name="/use_sim_time" value="$(arg use_sim_time)" />
  <node pkg="spherical_livo" type="spherical_livo_node" name="spherical_livo" output="screen" required="true">
    <rosparam command="load" file="$(arg config)" />
    <rosparam command="load" file="$(arg cameras)" />
    <param name="common/num_cameras" value="$(arg num_cameras)" />
    <param name="output_dir" value="$(arg output_dir)" />
  </node>
</launch>
