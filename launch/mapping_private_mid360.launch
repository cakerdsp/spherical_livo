<launch>
  <arg name="rviz" default="true" />
  <arg name="num_cameras" default="2" />
  <arg name="config" default="$(find spherical_livo)/config/private_mid360.yaml" />
  <arg name="cameras" default="$(find spherical_livo)/config/cameras_private_mid360.yaml" />
  <arg name="output_dir" default="" />
  <arg name="use_sim_time" default="false" />
  <arg name="lidar_type" default="8" />
  <param name="/use_sim_time" value="$(arg use_sim_time)" />
  <node pkg="spherical_livo" type="spherical_livo_node" name="spherical_livo" output="screen" required="true">
    <rosparam command="load" file="$(arg config)" />
    <rosparam command="load" file="$(arg cameras)" />
    <param name="common/num_cameras" value="$(arg num_cameras)" />
    <param name="preprocess/lidar_type" value="$(arg lidar_type)" />
    <param name="output_dir" value="$(arg output_dir)" />
  </node>
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find spherical_livo)/rviz_cfg/spherical_livo.rviz" output="screen" />
</launch>
